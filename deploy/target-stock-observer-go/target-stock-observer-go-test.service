[Unit]
Description=PokeAlert Target Stock Observer (Go shadow test)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hammikb
WorkingDirectory=/home/hammikb/target-stock-observer-go
EnvironmentFile=/home/hammikb/pi-health-reporter/pi-health-reporter.env
EnvironmentFile=-/home/hammikb/api-monitor-python/api-monitor.env
Environment=TARGET_STOCK_PROXY_FILE=/home/hammikb/api-monitor-python/proxies.txt
Environment=TARGET_STOCK_STATE_FILE=/home/hammikb/target-stock-observer-go/.shadow-state.json
Environment=TARGET_STOCK_SHADOW=true
Environment=TARGET_STOCK_PROXY_INDEX=0
Environment=TARGET_STOCK_CHECK_SECONDS=30
Environment=TARGET_STOCK_SLOW_CHECK_SECONDS=300
Environment=TARGET_STOCK_TIME_ZONE=America/Los_Angeles
Environment=TARGET_STOCK_FAST_WINDOW_START=23:30
Environment=TARGET_STOCK_FAST_WINDOW_END=03:30
Environment=TARGET_STOCK_REQUEST_SPACING_SECONDS=2
Environment=TARGET_STOCK_PRODUCT_REFRESH_SECONDS=300
Environment=TARGET_STOCK_PROXY_COOLDOWN_SECONDS=300
Environment=TARGET_STOCK_BLOCKED_BACKOFF_SECONDS=900
Environment=TARGET_STOCK_MAX_FAILOVERS=2
ExecStart=/home/hammikb/target-stock-observer-go/target-stock-observer
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
