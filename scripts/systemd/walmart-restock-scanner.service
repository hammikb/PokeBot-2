# Deployment template for the low-bandwidth Python Walmart scanner.
[Unit]
Description=Walmart Pokemon Restock Scanner (HTTP, proxy-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hammikb
WorkingDirectory=/home/hammikb/walmart-browser-probe
EnvironmentFile=/home/hammikb/walmart-browser-probe/.env
ExecStart=/home/hammikb/walmart-browser-probe/.venv/bin/python /home/hammikb/walmart-browser-probe/walmart_restock_scanner.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
