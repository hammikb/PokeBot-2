# Deployment template: install as a systemd unit on the monitoring Pi.
[Unit]
Description=PokeAlert Target Stock Observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hammikb
WorkingDirectory=/home/hammikb/api-monitor-python
Environment=PYTHONUNBUFFERED=1
Environment=TARGET_STOCK_PROXY_FILE=/home/hammikb/api-monitor-python/proxies.txt
Environment=TARGET_STOCK_PROXY_INDEX=0
Environment=TARGET_STOCK_CHECK_SECONDS=30
Environment=TARGET_STOCK_REQUEST_SPACING_SECONDS=2
Environment=TARGET_STOCK_PRODUCT_REFRESH_SECONDS=300
ExecStart=/home/hammikb/api-monitor-python/.venv/bin/python /home/hammikb/api-monitor-python/target_stock_observer.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
