# Supabase (PokeAlert) connection for the main process.
# Publishable (client) key — RLS-protected, safe to ship in the app.
# These are optional: src/main/supabase/config.js falls back to the same defaults,
# so the app works without a .env. Set them to point at a different project.
MAIN_VITE_SUPABASE_URL=https://jbnnouwhesexfllninwb.supabase.co
MAIN_VITE_SUPABASE_KEY=sb_publishable_ISHuDgo14iTtTsRdJFnkYQ__6e9nYlx

# Capsolver API key for automatic CAPTCHA solving
# Get your key at https://dashboard.capsolver.com
MAIN_VITE_CAPSOLVER_API_KEY=

# Vault password used to derive the encryption key for stored credentials
# CHANGE THIS to a strong, unique password. The app will use this to encrypt
# your account passwords, CVV numbers, and payment card data at rest.
# If omitted, a dev-only fallback is used (insecure for production).
MAIN_VITE_VAULT_PASSWORD=